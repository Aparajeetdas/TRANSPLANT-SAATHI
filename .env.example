# ==============================================================================
# TRANSPLANT SAATHI — ENVIRONMENT VARIABLES SPECIFICATION & CONFIGURATION
# ==============================================================================
# Copy this file to .env or .env.local to configure your local or production environment.
# All variables prefixed with VITE_ are compiled into the public client bundle.
#
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# CRITICAL SECURITY NOTICE:
# NEVER place SUPABASE_SERVICE_ROLE_KEY, PostgreSQL root passwords, or private
# certificates in frontend environment files or with a VITE_ prefix!
# All VITE_* environment variables are visible to users in their browser source code.
# Only the public anon key (JWT) is safe for client-side inclusion.
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
#
# ------------------------------------------------------------------------------
# 1. SUPABASE AUTH & POSTGRESQL API CONFIGURATION (REQUIRED FOR LIVE BACKEND)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard -> Project Settings -> API:
# - URL: Found under "Project URL" (e.g. https://xyzcompany.supabase.co)
# - Publishable Key: Found under "Project API keys" -> "anon" / "public" / "publishable"
#
# If omitted or left blank, the application operates in resilient Mock Prototype Mode
# using local browser storage and pre-configured test personas.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-publishable-key-here
# Backward-compatible alias for VITE_SUPABASE_PUBLISHABLE_KEY:
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-publishable-key-here

# ------------------------------------------------------------------------------
# 2. APPLICATION BASE URL & AUTH REDIRECT ENDPOINTS
# ------------------------------------------------------------------------------
# Base URL where the frontend is hosted. Used by Supabase Auth for email verification
# and password recovery redirection URLs.
# In your Supabase Dashboard under Authentication -> URL Configuration:
# - Site URL: http://localhost:5174 (or your production domain)
# - Redirect URLs must include:
#     - http://localhost:5174/auth/verify-email
#     - http://localhost:5174/auth/reset-password
#     - https://your-production-domain.com/auth/verify-email
#     - https://your-production-domain.com/auth/reset-password
VITE_APP_URL=http://localhost:5174

# ------------------------------------------------------------------------------
# 3. SUPABASE STORAGE BUCKETS
# ------------------------------------------------------------------------------
# Target Supabase Storage Bucket for encrypted patient document uploads:
VITE_SUPABASE_STORAGE_BUCKET_DOCUMENTS=patient_documents

# ------------------------------------------------------------------------------
# 4. STATUTORY HELPLINES & REGULATORY PORTALS (THOTA 1994 COMPLIANCE)
# ------------------------------------------------------------------------------
# Official 24/7 National Organ and Tissue Transplant Organisation helpline:
VITE_NOTTO_HELPLINE=1800-11-4770
VITE_NOTTO_PORTAL_URL=https://notto.mohfw.gov.in
VITE_PMJAY_PORTAL_URL=https://pmjay.gov.in
